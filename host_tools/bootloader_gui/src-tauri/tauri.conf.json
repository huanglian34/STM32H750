{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STM32H750 BootManager",
  "version": "1.0.0",
  "identifier": "com.lian.stm32h750.bootmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "STM32H750 QSPI Bootloader 控制中心",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
